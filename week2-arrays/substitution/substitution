string answering (string plaintext, string key)
{
        int length = strlen(plaintext);
        //printf("length : %i", length);
        char answear[length+1];

        for (int i = 0; i < length; i++)

        {

            if (plaintext[i] >= 'A' && plaintext[i] <= 'Z')
                {

                        answear[i] = key[plaintext[i]-65];
                        //printf("isupper : %c", answear[i]);
                        answear[i] = toupper(answear[i]);
                        continue;

                }

                if (plaintext[i] >= 'a' && plaintext[i] <= 'z')
                {
                        answear[i] = tolower(key[plaintext[i]-97]);
                        //printf("islower : %c", answear[i]);
                        continue;
                }

                answear[i] = plaintext[i];
                //printf("space : %c", answear[i]);
        }

        answear[length] = '\0';
        printf("ciphertext:");
        printf("%s\n", answear);

        return 0;
}
